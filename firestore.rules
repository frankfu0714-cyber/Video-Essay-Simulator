rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ stats/public：允許任何人讀＆寫（只限這一份文件）
    match /stats/public {
      allow read, write: if true;
    }

    // ✅ AI Feedback 匿名漏斗計數：任何人可讀；只能把允許的欄位各 +1
    match /stats/aiFunnel {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(aiFunnelSteps())
        && request.resource.data.keys().size() == 1
        && request.resource.data.values().hasOnly([1]);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(aiFunnelSteps())
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && stepsGrewByOne();
      allow delete: if false;
    }

    function aiFunnelSteps() {
      return ["seen", "opened", "signInShown", "signInClicked", "signedIn", "signInFailed",
              "ready", "limitReached", "analyzeClicked", "reviewOk", "reviewFailed"];
    }

    function grewByOne(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
        || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }

    function stepsGrewByOne() {
      return grewByOne("seen") && grewByOne("opened") && grewByOne("signInShown")
        && grewByOne("signInClicked") && grewByOne("signedIn") && grewByOne("signInFailed")
        && grewByOne("ready") && grewByOne("limitReached") && grewByOne("analyzeClicked")
        && grewByOne("reviewOk") && grewByOne("reviewFailed");
    }

    // ✅ 公開留言 comments：任何人可讀、可新增（不可改/刪）
    match /comments/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ✅ 使用者自己的 videos：只能本人讀寫
    match /users/{uid}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ✅ 使用者自己的 AI feedback：只能本人讀、存、刪
    match /users/{uid}/aiFeedback/{feedbackId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ❌ 其他所有資料：全部拒絕（安全）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
